# syntax=docker/dockerfile:1
#
# P0-I-3 — dev image. Installs the full dependency tree (dev included — `tsx watch` and Vite's
# dev server both come from devDependencies) and runs `npm run dev` (scripts/dev.mjs: Vite +
# `tsx watch` together). No build step: the compose file bind-mounts the real source over this
# image's `/app`, so what actually runs is whatever's on the host, live.

FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

EXPOSE 5173 8080

CMD ["npm", "run", "dev"]
