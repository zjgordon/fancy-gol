      "kind": "live",
      "countsAsAlive": true
    }
  ],
  "neighborhood": {
    "kind": "moore",
    "radius": 1
  },
  "transition": {
    "born": [
      3
    ],
    "survive": [
      2,
      3
    ]
  },
  "boundary": "toroidal"
}
