      "id": 1,
      "name": "alive",
      "kind": "live",
      "countsAsAlive": true
    }
  ],
  "neighborhood": {
    "kind": "moore",
    "radius": 1
  },
  "transition": {
    "kind": "turmite",
    "states": [
      {
        "state": 0,
        "onCellState": 9,
        "writeState": 1,
        "turn": "left",
        "nextState": 0
      }
    ]
  },
  "boundary": "toroidal"
}
